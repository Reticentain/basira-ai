# ── Images & dataset files (NEVER commit) ─────────────────────────────────────
/data/*
!/data/README.md
*.csv
!reports/splits/*.csv
!reports/splits/
*.xlsx

# ── Model weights & exports ───────────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.pkl
*.npy
checkpoints/

# ── Kaggle / API tokens (NEVER commit) ────────────────────────────────────────
*kaggle*.json
*.json.secret
.env
*.env

# ── Reports: generated outputs only (keep .md/.gitkeep stubs) ─────────────────
reports/*.json
!reports/eda_summary.json
reports/*.csv
!reports/splits/*.csv
!reports/splits/
reports/*.png
reports/*.html

# ── Python build artefacts ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb~

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
tmp/
scratch/
local.yaml
